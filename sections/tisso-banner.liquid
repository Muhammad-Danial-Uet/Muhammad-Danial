<section class="tisso-products" data-tisso-grid>

  <div class="tisso-products__header">
    <button
      type="button"
      class="tisso-mobile-menu-button"
      aria-label="Open menu"
      aria-expanded="false"
      data-tisso-mobile-menu-button
    >
      <span aria-hidden="true">☰</span>
    </button>

    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div
    class="tisso-products__grid"
    data-tisso-mobile-menu
  >

    {% for block in section.blocks %}
      {% assign product = block.settings.product %}

      {% if product != blank %}

        <article
          class="tisso-product-card"
          {{ block.shopify_attributes }}
          data-product-card
        >

          <div class="tisso-product-card__image-wrapper">

            {% if product.featured_image %}
              {{
                product.featured_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'tisso-product-card__image',
                  alt: product.featured_image.alt | default: product.title | escape
              }}
            {% endif %}

            <button
              type="button"
              class="tisso-hotspot"
              data-product-popup-open
              aria-label="View {{ product.title | escape }}"
            >
              <span aria-hidden="true">+</span>
            </button>

          </div>

          <script type="application/json" data-product-data>
            {{ product | json }}
          </script>

        </article>

      {% endif %}
    {% endfor %}

  </div>

</section>

<div
  class="tisso-popup"
  data-tisso-popup
  aria-hidden="true"
>

  <div
    class="tisso-popup__overlay"
    data-product-popup-close
  ></div>

  <div
    class="tisso-popup__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tisso-popup-title"
  >

    <button
      type="button"
      class="tisso-popup__close"
      data-product-popup-close
      aria-label="Close product details"
    >
      ×
    </button>

    <div class="tisso-popup__image">
      <img
        src=""
        alt=""
        data-popup-image
      >
    </div>

    <div class="tisso-popup__content">

      <h2
        id="tisso-popup-title"
        data-popup-title
      ></h2>

      <div
        class="tisso-popup__price"
        data-popup-price
      ></div>

      <div
        class="tisso-popup__description"
        data-popup-description
      ></div>

      <form data-add-to-cart-form>

        <div
          class="tisso-popup__variants"
          data-popup-variants
        ></div>

        <button
          type="submit"
          class="tisso-add-button"
          data-add-to-cart
        >
          <span data-add-to-cart-text>
            ADD TO CART
          </span>

          <span class="tisso-add-button__arrow">
            →
          </span>
        </button>

        <p
          class="tisso-popup__error"
          data-popup-error
          hidden
        ></p>

      </form>

    </div>

  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const button = document.querySelector('[data-tisso-mobile-menu-button]');
  const menu = document.querySelector('[data-tisso-mobile-menu]');

  if (!button || !menu) return;

  button.addEventListener('click', function () {
    const isOpen = button.getAttribute('aria-expanded') === 'true';

    button.setAttribute('aria-expanded', String(!isOpen));
    menu.hidden = isOpen;
  });
});
</script>

{% schema %}
{
  "name": "Tisso Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tisso Product Grid"
    }
  ]
}
{% endschema %}
