<section class="tisso-banner">

  <!-- MOBILE HEADER -->
  <div class="tisso-mobile-header">

    <button
      type="button"
      class="tisso-mobile-menu-button"
      aria-label="Open menu"
      aria-expanded="false"
      data-tisso-mobile-menu
    >
      <span class="tisso-mobile-menu-icon">☰</span>
    </button>

    <div class="tisso-mobile-brand">
      {{ section.settings.brand_text }}
    </div>

  </div>

  <!-- MOBILE MENU -->
  <div
    class="tisso-mobile-menu"
    data-tisso-mobile-panel
    hidden
  >

    <div class="tisso-mobile-menu__message">
      {{ section.settings.top_message }}
    </div>

    <a
      href="{{ section.settings.top_button_link | default: '#' }}"
      class="tisso-button tisso-button--yellow tisso-mobile-menu__button"
    >
      <span>{{ section.settings.top_button_text }}</span>
      <span class="tisso-button__arrow">→</span>
    </a>

  </div>


  <!-- DESKTOP TOP BAR -->
  <div class="tisso-banner__top">

    <div class="tisso-banner__brand">
      {{ section.settings.brand_text }}
    </div>

    <div class="tisso-banner__message">
      {{ section.settings.top_message }}
    </div>

    <a
      href="{{ section.settings.top_button_link | default: '#' }}"
      class="tisso-button tisso-button--yellow tisso-banner__choose-gift"
    >
      <span>{{ section.settings.top_button_text }}</span>
      <span class="tisso-button__arrow">→</span>
    </a>

  </div>


  <!-- BANNER -->
  <div class="tisso-banner__content">

    {% if section.settings.banner_image != blank %}

      <img
        class="tisso-banner__background"
        src="{{ section.settings.banner_image | image_url: width: 2400 }}"
        srcset="
          {{ section.settings.banner_image | image_url: width: 750 }} 750w,
          {{ section.settings.banner_image | image_url: width: 1200 }} 1200w,
          {{ section.settings.banner_image | image_url: width: 1800 }} 1800w,
          {{ section.settings.banner_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        width="{{ section.settings.banner_image.width }}"
        height="{{ section.settings.banner_image.height }}"
        alt="{{ section.settings.banner_image.alt | escape }}"
        loading="eager"
      >

    {% endif %}


    <div class="tisso-banner__inner">

      <h1 class="tisso-banner__title">
        {{ section.settings.heading }}
      </h1>

      <div class="tisso-banner__description">
        {{ section.settings.description }}
      </div>

      <a
        href="{{ section.settings.main_button_link | default: '#' }}"
        class="tisso-button tisso-button--black tisso-banner__shop-now"
      >
        <span>{{ section.settings.main_button_text }}</span>
        <span class="tisso-button__arrow">→</span>
      </a>

    </div>

  </div>


  <!-- BOTTOM ANNOUNCEMENT -->
  <div class="tisso-banner__announcement">
    {{ section.settings.bottom_message }}
  </div>

</section>


<!-- MOBILE MENU SCRIPT -->

<script>

(function() {

  const menuButton =
    document.querySelector('[data-tisso-mobile-menu]');

  const menuPanel =
    document.querySelector('[data-tisso-mobile-panel]');

  if (!menuButton || !menuPanel) {
    return;
  }

  menuButton.addEventListener('click', function() {

    const isOpen =
      menuButton.getAttribute('aria-expanded') === 'true';

    if (isOpen) {

      menuButton.setAttribute(
        'aria-expanded',
        'false'
      );

      menuButton.setAttribute(
        'aria-label',
        'Open menu'
      );

      menuPanel.hidden = true;

    } else {

      menuButton.setAttribute(
        'aria-expanded',
        'true'
      );

      menuButton.setAttribute(
        'aria-label',
        'Close menu'
      );

      menuPanel.hidden = false;

    }

  });

})();

</script>


{% schema %}

{
  "name": "Tisso Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner background image"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "TISSO VISION"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Top message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Choose Gift button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Choose Gift button link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover our collection of gifts designed to make every moment special.</p>"
    },
    {
      "type": "text",
      "id": "main_button_text",
      "label": "Shop Now button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "main_button_link",
      "label": "Shop Now button link"
    },
    {
      "type": "text",
      "id": "bottom_message",
      "label": "Bottom announcement",
      "default": "FREE SHIPPING ON ORDERS OVER $100"
    }
  ],
  "presets": [
    {
      "name": "Tisso Banner"
    }
  ]
}

{% endschema %}
