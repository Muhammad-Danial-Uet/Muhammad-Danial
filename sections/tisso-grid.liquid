<section class="tisso-products" data-tisso-grid>

  <div class="tisso-products__header">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="tisso-products__grid">

    {% for block in section.blocks %}
      {% assign product = block.settings.product %}

      {% if product != blank %}

        <article
          class="tisso-product-card"
          {{ block.shopify_attributes }}
          data-product-card
        >

          <div class="tisso-product-card__image-wrapper">

            {% if product.featured_image %}
              {{
                product.featured_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'tisso-product-card__image',
                  alt: product.featured_image.alt | default: product.title | escape
              }}
            {% endif %}

            <button
              type="button"
              class="tisso-hotspot"
              data-product-popup-open
              aria-label="View {{ product.title | escape }}"
              style="--hotspot-x: {{ block.settings.hotspot_x }}%; --hotspot-y: {{ block.settings.hotspot_y }}%;"
            >
              <span aria-hidden="true">+</span>
            </button>

          </div>

          <script
            type="application/json"
            data-product-data
          >{{ product | json }}</script>

        </article>

      {% endif %}
    {% endfor %}

  </div>

</section>


<!-- PRODUCT POPUP -->

<div
  class="tisso-popup"
  data-tisso-popup
  aria-hidden="true"
>

  <!-- Dark overlay -->
  <div
    class="tisso-popup__overlay"
    data-product-popup-close
  ></div>


  <!-- Popup -->
  <div
    class="tisso-popup__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tisso-popup-title"

    style="
      display:block;
      width:360px;
      max-width:calc(100vw - 30px);
      max-height:calc(100vh - 30px);
      overflow-y:auto;
      padding:42px 24px 28px;
      box-sizing:border-box;
      position:relative;
    "
  >

    <!-- CLOSE -->
    <button
      type="button"
      class="tisso-popup__close"
      data-product-popup-close
      aria-label="Close product details"
    >
      ×
    </button>


    <!-- ================================================
         PRODUCT TOP INFORMATION
         ================================================ -->

    <div
      class="tisso-popup-product-top"
      style="
        display:grid;
        grid-template-columns:140px 1fr;
        column-gap:10px;
        align-items:start;
        margin-bottom:18px;
      "
    >

      <!-- PRODUCT IMAGE -->

      <div
        class="tisso-popup__image"
        style="
          width:140px;
          height:162px;
          min-height:0;
          margin:0;
          overflow:hidden;
          background:#f5f5f5;
        "
      >

        <img
          src=""
          alt=""
          data-popup-image
          style="
            width:100%;
            height:100%;
            display:block;
            object-fit:cover;
          "
        >

      </div>


      <!-- PRODUCT INFORMATION -->

      <div
        class="tisso-popup-product-info"
        style="
          min-width:0;
          padding:0;
        "
      >

        <h2
          id="tisso-popup-title"
          data-popup-title
          style="
            margin:14px 0 20px;
            padding:0;
            font-size:16px;
            line-height:1.2;
            font-weight:400;
          "
        ></h2>


        <div
          class="tisso-popup__price"
          data-popup-price
          style="
            margin:0 0 14px;
            font-size:18px;
            line-height:1.2;
            font-weight:400;
          "
        ></div>


        <div
          class="tisso-popup__description"
          data-popup-description
          style="
            margin:0;
            font-size:14px;
            line-height:1.2;
          "
        ></div>

      </div>

    </div>


    <!-- ================================================
         FORM
         ================================================ -->

    <form data-add-to-cart-form>


      <!-- VARIANTS -->

      <div
        class="tisso-popup__variants"
        data-popup-variants
        style="
          clear:both;
          width:100%;
        "
      ></div>


      <!-- ============================================
           ADD TO CART
           ============================================ -->

      <button
        type="submit"
        class="tisso-add-button"
        data-add-to-cart
        style="
          width:100%;
          height:52px;
          margin-top:15px;
          padding:0 18px;
          display:flex;
          align-items:center;
          justify-content:space-between;
          box-sizing:border-box;
        "
      >

        <span
          data-add-to-cart-text
        >
          ADD TO CART
        </span>

        <span
          class="tisso-add-button__arrow"
        >
          →
        </span>

      </button>


      <!-- ERROR -->

      <p
        class="tisso-popup__error"
        data-popup-error
        hidden
      ></p>


    </form>

  </div>

</div>

{% schema %}
{
  "name": "Tisso Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Plus horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Plus vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tisso Product Grid"
    }
  ]
}
{% endschema %}
