<section class="tisso-products" data-tisso-grid>

  <div class="tisso-products__header">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="tisso-products__grid">

    {% for block in section.blocks %}
      {% assign product = block.settings.product %}

      {% if product != blank %}

        <article
          class="tisso-product-card"
          {{ block.shopify_attributes }}
          data-product-card
        >

          <div class="tisso-product-card__image-wrapper">

            {% if product.featured_image %}
              {{
                product.featured_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'tisso-product-card__image',
                  alt: product.featured_image.alt | default: product.title | escape
              }}
            {% endif %}

            <!-- Product hotspot -->
            <button
              type="button"
              class="tisso-hotspot"
              data-product-popup-open
              aria-label="View {{ product.title | escape }}"
              style="--hotspot-x: {{ block.settings.hotspot_x }}%; --hotspot-y: {{ block.settings.hotspot_y }}%;"
            >
              <span aria-hidden="true">+</span>
            </button>

          </div>

          <!-- Product data -->
<script
  type="application/json"
  data-product-data
>
  {{ product.handle | json }}
</script>

        </article>

      {% endif %}
    {% endfor %}

  </div>

</section>

<!-- Product popup -->
<div
  class="tisso-popup"
  data-tisso-popup
  aria-hidden="true"
>

  <!-- Popup overlay -->
  <div
    class="tisso-popup__overlay"
    data-product-popup-close
  ></div>

  <!-- Popup dialog -->
  <div
    class="tisso-popup__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tisso-popup-title"
  >

    <!-- Close button -->
    <button
      type="button"
      class="tisso-popup__close"
      data-product-popup-close
      aria-label="Close product details"
    >
      ×
    </button>

    <!-- Product image + information -->
    <div class="tisso-popup-product-top">

      <!-- Product image -->
      <div class="tisso-popup__image">
        <img
          src=""
          alt=""
          data-popup-image
        >
      </div>

      <!-- Product information -->
      <div class="tisso-popup-product-info">

        <h2
          id="tisso-popup-title"
          data-popup-title
        ></h2>

        <div
          class="tisso-popup__price"
          data-popup-price
        ></div>

        <div
          class="tisso-popup__description"
          data-popup-description
        ></div>

      </div>

    </div>

    <!-- Variants and add to cart -->
    <div class="tisso-popup__content">

      <form data-add-to-cart-form>

        <div
          class="tisso-popup__variants"
          data-popup-variants
        ></div>

        <!-- Add to cart -->
        <button
          type="submit"
          class="tisso-add-button"
          data-add-to-cart
        >
          <span data-add-to-cart-text>
            ADD TO CART
          </span>

          <span class="tisso-add-button__arrow">
            →
          </span>
        </button>

        <!-- Error -->
        <p
          class="tisso-popup__error"
          data-popup-error
          hidden
        ></p>

      </form>

    </div>

  </div>

</div>

{% schema %}
{
  "name": "Tisso Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Plus horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Plus vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tisso Product Grid"
    }
  ]
}
{% endschema %}
