<section class="tisso-products" data-tisso-grid>

  <div class="tisso-products__header">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="tisso-products__grid">

    {% for block in section.blocks %}
      {% assign product = block.settings.product %}

      {% if product != blank %}

        <article
          class="tisso-product-card"
          {{ block.shopify_attributes }}
          data-product-card
        >

          <div class="tisso-product-card__image-wrapper">

            {% if product.featured_image %}
              {{
                product.featured_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'tisso-product-card__image',
                  alt: product.featured_image.alt | default: product.title | escape
              }}
            {% endif %}

            <!-- Product hotspot -->
            <button
              type="button"
              class="tisso-hotspot"
              data-product-popup-open
              aria-label="View {{ product.title | escape }}"
              style="--hotspot-x: {{ block.settings.hotspot_x }}%; --hotspot-y: {{ block.settings.hotspot_y }}%;"
            >
              <span aria-hidden="true">+</span>
            </button>

          </div>

          <!-- Product data -->
          <script
            type="application/json"
            data-product-data
          >
            {{ product | json }}
          </script>

        </article>

      {% endif %}
    {% endfor %}

  </div>

</section>

<!-- Product popup -->
<div
  class="tisso-popup"
  data-tisso-popup
  aria-hidden="true"
>

  <!-- Popup overlay -->
  <div
    class="tisso-popup__overlay"
    data-product-popup-close
  ></div>

  <!-- Popup dialog -->
  <div
    class="tisso-popup__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tisso-popup-title"
  >

    <!-- Close button -->
    <button
      type="button"
      class="tisso-popup__close"
      data-product-popup-close
      aria-label="Close product details"
    >
      ×
    </button>

    <!-- Product image -->
    <div class="tisso-popup__image">
      <img
        src=""
        alt=""
        data-popup-image
      >
    </div>

    <!-- Product information -->
    <div class="tisso-popup__content">

      <h2
        id="tisso-popup-title"
        data-popup-title
      ></h2>

      <div
        class="tisso-popup__price"
        data-popup-price
      ></div>

      <div
        class="tisso-popup__description"
        data-popup-description
      ></div>

      <!-- Variants and add to cart -->
      <form data-add-to-cart-form>

        <div
          class="tisso-popup__variants"
          data-popup-variants
        ></div>

        <!-- Add to cart button -->
        <button
          type="submit"
          class="tisso-add-button"
          data-add-to-cart
        >
          <span data-add-to-cart-text>ADD TO CART</span>
          <span class="tisso-add-button__arrow">→</span>
        </button>

        <!-- Error -->
        <p
          class="tisso-popup__error"
          data-popup-error
          hidden
        ></p>

      </form>

    </div>

  </div>

</div>

<!-- Product popup functionality -->
<script>
(function () {

  function initTissoGrid() {

    var grids = document.querySelectorAll('[data-tisso-grid]');

    grids.forEach(function (grid) {

      if (grid.dataset.tissoInitialized === 'true') {
        return;
      }

      grid.dataset.tissoInitialized = 'true';

      var popup = document.querySelector('[data-tisso-popup]');

      if (!popup) {
        return;
      }

      var openButtons = grid.querySelectorAll('[data-product-popup-open]');
      var closeButtons = popup.querySelectorAll('[data-product-popup-close]');

      var popupImage = popup.querySelector('[data-popup-image]');
      var popupTitle = popup.querySelector('[data-popup-title]');
      var popupPrice = popup.querySelector('[data-popup-price]');
      var popupDescription = popup.querySelector('[data-popup-description]');
      var variantsContainer = popup.querySelector('[data-popup-variants]');
      var addToCartForm = popup.querySelector('[data-add-to-cart-form]');
      var addToCartButton = popup.querySelector('[data-add-to-cart]');
      var addToCartText = popup.querySelector('[data-add-to-cart-text]');
      var errorMessage = popup.querySelector('[data-popup-error]');

      var currentProduct = null;
      var selectedOptions = [];
      var selectedVariant = null;

      function formatMoney(cents) {

        cents = Number(cents || 0);

        return (cents / 100).toLocaleString(undefined, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }) + '€';

      }

      function getProductImage(product) {

        if (!product) {
          return '';
        }

        if (product.featured_image) {

          if (typeof product.featured_image === 'string') {
            return product.featured_image;
          }

          if (product.featured_image.src) {
            return product.featured_image.src;
          }

        }

        if (product.images && product.images.length) {
          return product.images[0];
        }

        return '';

      }

      function getOptionName(option, index) {

        if (typeof option === 'string') {
          return option;
        }

        if (option && option.name) {
          return option.name;
        }

        return 'Option ' + (index + 1);

      }

      function getProductOptions() {

        if (!currentProduct || !currentProduct.options) {
          return [];
        }

        return currentProduct.options.map(function (option, index) {
          return getOptionName(option, index);
        });

      }

      function findMatchingVariant() {

        if (!currentProduct || !currentProduct.variants) {
          return null;
        }

        return currentProduct.variants.find(function (variant) {

          if (!variant.available) {
            return false;
          }

          if (!variant.options || !variant.options.length) {
            return true;
          }

          return variant.options.every(function (option, index) {
            return option === selectedOptions[index];
          });

        }) || null;

      }

      function updateVariant() {

        selectedVariant = findMatchingVariant();

        if (!selectedVariant) {

          addToCartButton.disabled = true;
          addToCartText.textContent = 'UNAVAILABLE';

          return;
        }

        addToCartButton.disabled = false;
        addToCartText.textContent = 'ADD TO CART';

        popupPrice.textContent = formatMoney(selectedVariant.price);

      }

      function createVariants() {

        variantsContainer.innerHTML = '';

        selectedOptions = [];

        if (!currentProduct || !currentProduct.variants) {
          addToCartButton.disabled = true;
          return;
        }

        var options = getProductOptions();

        var firstAvailableVariant = currentProduct.variants.find(function (variant) {
          return variant.available;
        });

        var defaultVariant = firstAvailableVariant || currentProduct.variants[0];

        if (defaultVariant && defaultVariant.options) {

          selectedOptions = defaultVariant.options.slice();

        }

        if (options.length === 0 || currentProduct.variants.length <= 1) {

          selectedVariant = defaultVariant;

          if (!selectedVariant || !selectedVariant.available) {

            addToCartButton.disabled = true;
            addToCartText.textContent = 'SOLD OUT';

          } else {

            addToCartButton.disabled = false;
            addToCartText.textContent = 'ADD TO CART';
            popupPrice.textContent = formatMoney(selectedVariant.price);

          }

          return;
        }

        options.forEach(function (optionName, optionIndex) {

          var wrapper = document.createElement('div');

          wrapper.className = 'tisso-variant';

          var label = document.createElement('label');

          label.textContent = optionName;

          wrapper.appendChild(label);

          var values = [];

          currentProduct.variants.forEach(function (variant) {

            if (!variant.options) {
              return;
            }

            var value = variant.options[optionIndex];

            if (value && !values.includes(value)) {
              values.push(value);
            }

          });

          if (optionIndex === 0 && values.length <= 4) {

            var buttons = document.createElement('div');

            buttons.className = 'tisso-variant-buttons';

            values.forEach(function (value) {

              var button = document.createElement('button');

              button.type = 'button';
              button.className = 'tisso-variant-option';
              button.textContent = value;

              if (selectedOptions[optionIndex] === value) {
                button.classList.add('is-selected');
              }

              var hasAvailableVariant = currentProduct.variants.some(function (variant) {

                return (
                  variant.available &&
                  variant.options &&
                  variant.options[optionIndex] === value
                );

              });

              if (!hasAvailableVariant) {
                button.disabled = true;
              }

              button.addEventListener('click', function () {

                selectedOptions[optionIndex] = value;

                buttons.querySelectorAll('.tisso-variant-option').forEach(function (item) {
                  item.classList.remove('is-selected');
                });

                button.classList.add('is-selected');

                updateVariant();

              });

              buttons.appendChild(button);

            });

            wrapper.appendChild(buttons);

          } else {

            var select = document.createElement('select');

            select.className = 'tisso-variant-select';

            values.forEach(function (value) {

              var optionElement = document.createElement('option');

              optionElement.value = value;
              optionElement.textContent = value;

              if (selectedOptions[optionIndex] === value) {
                optionElement.selected = true;
              }

              select.appendChild(optionElement);

            });

            select.addEventListener('change', function () {

              selectedOptions[optionIndex] = select.value;

              updateVariant();

            });

            wrapper.appendChild(select);

          }

          variantsContainer.appendChild(wrapper);

        });

        updateVariant();

      }

      function openPopup(product) {

        if (!product) {
          return;
        }

        currentProduct = product;
        selectedOptions = [];
        selectedVariant = null;

        var imageUrl = getProductImage(product);

        popupImage.src = imageUrl;
        popupImage.alt = product.title || '';

        popupTitle.textContent = product.title || '';

        popupPrice.textContent = formatMoney(product.price);

        popupDescription.innerHTML = product.description || '';

        errorMessage.hidden = true;
        errorMessage.textContent = '';

        createVariants();

        popup.classList.add('is-open');

        popup.setAttribute('aria-hidden', 'false');

        document.body.classList.add('tisso-popup-open');

      }

      function closePopup() {

        popup.classList.remove('is-open');

        popup.setAttribute('aria-hidden', 'true');

        document.body.classList.remove('tisso-popup-open');

        currentProduct = null;

        selectedVariant = null;

      }

      openButtons.forEach(function (button) {

        button.addEventListener('click', function () {

          var card = button.closest('[data-product-card]');

          if (!card) {
            return;
          }

          var productData = card.querySelector('[data-product-data]');

          if (!productData) {
            return;
          }

          try {

            var product = JSON.parse(productData.textContent);

            openPopup(product);

          } catch (error) {

            console.error('Tisso product data error:', error);

          }

        });

      });

      closeButtons.forEach(function (button) {

        button.addEventListener('click', function () {
          closePopup();
        });

      });

      document.addEventListener('keydown', function (event) {

        if (
          event.key === 'Escape' &&
          popup.getAttribute('aria-hidden') === 'false'
        ) {

          closePopup();

        }

      });

      addToCartForm.addEventListener('submit', function (event) {

        event.preventDefault();

        errorMessage.hidden = true;
        errorMessage.textContent = '';

        if (!selectedVariant || !selectedVariant.available) {

          errorMessage.textContent = 'Please select an available variant.';
          errorMessage.hidden = false;

          return;

        }

        addToCartButton.disabled = true;
        addToCartText.textContent = 'ADDING...';

        fetch('/cart/add.js', {

          method: 'POST',

          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },

          body: JSON.stringify({
            items: [
              {
                id: selectedVariant.id,
                quantity: 1
              }
            ]
          })

        })

        .then(function (response) {

          return response.json().then(function (data) {

            if (!response.ok) {

              throw new Error(
                data.description || 'Unable to add product to cart.'
              );

            }

            return data;

          });

        })

        .then(function () {

          addToCartText.textContent = 'ADDED';

          setTimeout(function () {

            closePopup();

            addToCartText.textContent = 'ADD TO CART';

            addToCartButton.disabled = false;

          }, 700);

        })

        .catch(function (error) {

          console.error('Tisso add to cart error:', error);

          errorMessage.textContent =
            error.message || 'Unable to add this product to cart.';

          errorMessage.hidden = false;

          addToCartText.textContent = 'ADD TO CART';

          addToCartButton.disabled = false;

        });

      });

    });

  }

  if (document.readyState === 'loading') {

    document.addEventListener('DOMContentLoaded', initTissoGrid);

  } else {

    initTissoGrid();

  }

  document.addEventListener('shopify:section:load', function () {

    initTissoGrid();

  });

})();
</script>

{% schema %}
{
  "name": "Tisso Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Plus horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Plus vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tisso Product Grid"
    }
  ]
}
{% endschema %}
